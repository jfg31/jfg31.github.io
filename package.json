{
  "name": "portfolio-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/resume-docx.mjs && node scripts/resume-pdf.mjs && node scripts/check-contract.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "export": "node --env-file-if-exists=.env.local scripts/export.mjs",
    "lint:privacy": "node --env-file-if-exists=.env.local scripts/privacy-lint.mjs",
    "check": "astro check",
    "release:check": "pnpm export && pnpm lint:privacy && pnpm test && pnpm check && pnpm build"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "docx": "~9.8.1",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.2",
    "playwright-core": "~1.63.0",
    "typescript": "^6.0.3",
    "unpdf": "^1.8.1",
    "vitest": "^5.0.3"
  }
}
