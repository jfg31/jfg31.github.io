---
import Layout from './Layout.astro';
import CaseCard from './CaseCard.astro';
import type { ThemeProps } from '../contract';
import { groupByCategory } from '../../lib/cases';

type Props = ThemeProps;
const { locale, ui, profile, cases } = Astro.props;
---
<Layout locale={locale} ui={ui} profile={profile} title={ui.allProjects} subpath="projects">
  <h1>{ui.allProjects}</h1>
  {groupByCategory(cases).map(([category, items]) => (
    <section>
      <h2>{ui.categories[category]}</h2>
      <div class="grid">
        {items.map((item) => <CaseCard item={item} locale={locale} ui={ui} />)}
      </div>
    </section>
  ))}
</Layout>
