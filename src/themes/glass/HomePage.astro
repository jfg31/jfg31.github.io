---
// Inicio del tema glass (portado de E-liquid-glass: hero, trabajo destacado, índice; el contacto vive en el footer del Layout).
// Las pastillas del hero son anclas #work-<slug>: sin JS llevan al panel del caso; con JS WorkTabs abre su pestaña.
import Layout from './Layout.astro';
import WorkTabs from './WorkTabs.astro';
import ProjectIndex from './ProjectIndex.astro';
import type { ThemeProps } from '../contract';
import { featuredCases } from '../../lib/cases';
import { md } from '../../lib/markdown';
import { localePath } from '../../i18n/ui';
import { currentRole, pad2, shortTitleOf, splitHeadline } from './scripts/text';

type Props = ThemeProps;
const { locale, ui, profile, cases } = Astro.props;
const text = profile.text[locale];
const [headA, headB] = splitHeadline(text.headline);
const role = currentRole(text.experience);
const featured = featuredCases(cases);
// orden de la barra flotante: Trabajo, Índice, Contacto (ids que usa scripts/controls.ts) y Sobre mí (enlace a página).
// Sin casos destacados no se renderiza #work, así que su pestaña tampoco.
const sections = [
  ...(featured.length > 0 ? [{ id: 'work', label: ui.sections.work }] : []),
  { id: 'index', label: ui.sections.index },
  { id: 'contact', label: ui.sections.contact },
  { id: 'about', label: ui.nav.about, href: localePath(locale, 'about') },
];
---
<Layout locale={locale} ui={ui} profile={profile} sections={sections}>
  <section class="hero wrap" aria-labelledby="name">
    <h1 id="name" translate="no">{profile.name}</h1>
    <div class="hero-row">
      <div class="headline">
        <p>{headA}{headB && <> <span class="soft">{headB}</span></>}</p>
        {role && <p class="hero-meta mono">{role}</p>}
      </div>
      <div class="about prose" set:html={md(text.about)} />
    </div>
    {featured.length > 0 && (
      <nav class="hero-projects" aria-labelledby="hero-projects-h">
        <p class="kicker" id="hero-projects-h">{ui.selectedProjects}</p>
        <ul>
          {featured.map((item, i) => (
            <li>
              <a class="pill" href={`#work-${item.slug}`}>
                <span class="n" aria-hidden="true">{pad2(i + 1)}</span>
                <span class="t">{shortTitleOf(item, locale)}</span>
                <span class="c">{ui.categories[item.category]}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </section>

  {featured.length > 0 && <WorkTabs locale={locale} ui={ui} items={featured} total={cases.length} />}

  <section id="index" class="wrap sec" aria-labelledby="index-h">
    <div class="sec-head">
      <div>
        <p class="kicker">{ui.sections.index} · {pad2(cases.length)}</p>
        <h2 id="index-h">{ui.allProjects}</h2>
      </div>
    </div>
    <ProjectIndex locale={locale} ui={ui} cases={cases} level={3} />
  </section>
</Layout>
