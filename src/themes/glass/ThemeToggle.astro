---
import type { UiStrings } from '../contract';

interface Props {
  ui: UiStrings;
}

const { ui } = Astro.props;
// Botón simple de ciclo (sin aria-pressed: tres modos no son un toggle de dos estados).
// El nombre accesible dice el modo actual y la acción siguiente: "Color theme: System — switch to Light".
// El estado real lo fija el script inline del <head>; aquí se renderiza "system" (el valor por defecto)
// y el script de abajo lo sincroniza al cargar.
const initialLabel = `${ui.theme.label}: ${ui.theme.system} — ${ui.theme.switchTo} ${ui.theme.light}`;
---
<button
  type="button"
  class="theme-btn"
  data-theme-toggle
  data-label={ui.theme.label}
  data-switch-to={ui.theme.switchTo}
  data-light={ui.theme.light}
  data-dark={ui.theme.dark}
  data-system={ui.theme.system}
  aria-label={initialLabel}
  title={initialLabel}
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path class="half half-r" d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor" />
    <path class="half half-l" d="M12 3.75a8.25 8.25 0 0 0 0 16.5z" fill="currentColor" />
  </svg>
</button>

<script>
  type Mode = 'light' | 'dark' | 'system';
  // Ciclo: Light → Dark → System → Light
  const ORDER: Mode[] = ['light', 'dark', 'system'];

  function currentMode(): Mode {
    const value = document.documentElement.dataset.theme;
    return ORDER.includes(value as Mode) ? (value as Mode) : 'system';
  }

  function nextMode(mode: Mode): Mode {
    return ORDER[(ORDER.indexOf(mode) + 1) % ORDER.length];
  }

  /** La barra del navegador sigue al modo: explícito = ese color en las dos metas; sistema = cada meta con su media. */
  function syncThemeColor(mode: Mode): void {
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => {
      const forced = mode === 'system' ? null : mode;
      const dark = forced ? forced === 'dark' : m.media.includes('dark');
      m.content = (dark ? m.dataset.bgDark : m.dataset.bgLight) ?? m.content;
    });
  }

  function sync(btn: HTMLButtonElement): void {
    const mode = currentMode();
    const label = `${btn.dataset.label}: ${btn.dataset[mode]} — ${btn.dataset.switchTo} ${btn.dataset[nextMode(mode)]}`;
    btn.setAttribute('aria-label', label);
    btn.title = label;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    sync(btn);
    btn.addEventListener('click', () => {
      const next = nextMode(currentMode());
      document.documentElement.dataset.theme = next;
      syncThemeColor(next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        // almacenamiento bloqueado (modo privado, cookies desactivadas): el cambio vale solo para esta página
      }
      sync(btn);
    });
  });
</script>
