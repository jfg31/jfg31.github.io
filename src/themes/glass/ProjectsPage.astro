---
// Todos los proyectos: el índice tipográfico a página completa. Enlaza a cada caso (lo verifica el contrato).
import Layout from './Layout.astro';
import ProjectIndex from './ProjectIndex.astro';
import type { ThemeProps } from '../contract';
import { pad2 } from './scripts/text';

type Props = ThemeProps;
const { locale, ui, profile, cases } = Astro.props;
---
<Layout locale={locale} ui={ui} profile={profile} title={ui.allProjects} subpath="projects">
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">{ui.sections.index} · {pad2(cases.length)}</p>
      <h1>{ui.allProjects}</h1>
    </header>
    <ProjectIndex locale={locale} ui={ui} cases={cases} level={2} />
  </div>
</Layout>
